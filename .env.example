# Copy to .env.local (never commit real keys). Set the same variables in Vercel → Project → Settings → Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: email admin inquiry replies to clients through EmailJS (emailjs.com, free tier).
# The reply template receives to_email, to_name, subject, message and inquiry_number.
# Without these, sending a reply opens your email app with the reply filled in instead.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_REPLY_TEMPLATE_ID=
